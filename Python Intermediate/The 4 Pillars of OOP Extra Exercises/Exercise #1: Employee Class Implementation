class Employee:
    def __init__(self, name, salary):
        self._name = name
        self.salary = salary  # uses the setter for validation

    # Getter for name
    @property
    def name(self):
        return self._name

    # Getter for salary
    @property
    def salary(self):
        return self._salary

    # Setter for salary with validation
    @salary.setter
    def salary(self, value):
        if value < 0:
            raise ValueError("Salary cannot be negative")
        self._salary = value

    # Method to increase salary by a given percentage
    def promote(self, percentage):
        if percentage < 0:
            raise ValueError("Percentage must be positive")
        self._salary += self._salary * percentage
