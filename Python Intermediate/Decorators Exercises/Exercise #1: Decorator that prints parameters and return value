def log_params_and_return(func):
    def wrapper(*args, **kwargs):
        print("Parameters:", args, kwargs)
        result = func(*args, **kwargs)
        print("Return value:", result)
        return result
    return wrapper

# Example 
@log_params_and_return
def multiply(a, b):
    return a * b


multiply(3, 4)
# Return Example would be 
# Parameters: (3, 4) {}
# Return value: 12
