    count_upper_lower,
    sort_hyphen_words,
    primes_from_list,
)


# ========= EXERCISE 3: sum of list =========
@pytest.mark.parametrize(
    "numbers, expected",
    [
        ([4, 6, 2, 29], 41),          # normal case
        ([], 0),                      # valid edge case: empty list
        ([-5, 10, 0, 3], 8),          # includes negatives and zero
    ],
)
def test_sum_list_success(numbers, expected):
    assert sum_list(numbers) == expected


# ========= EXERCISE 4: reverse string =========
@pytest.mark.parametrize(
    "text, expected",
    [
        ("Hello world", "dlrow olleH"),   # normal case
        ("", ""),                         # edge case: empty string
        ("AbC 123!", "!321 CbA"),          # mix of uppercase, spaces, symbols
    ],
)
def test_reverse_string_success(text, expected):
    assert reverse_string(text) == expected


# ========= EXERCISE 5: count uppercase and lowercase =========
@pytest.mark.parametrize(
    "text, expected",
    [
        ("I love Nación Sushi", (3, 13)),  # example from prompt
        ("ABCdef", (3, 3)),                # balanced case
        ("all lowercase", (0, 12)),        # only lowercase (excluding space)
    ],
)
def test_count_upper_lower_success(text, expected):
    assert count_upper_lower(text) == expected


# ========= EXERCISE 6: sort hyphen-separated words =========
@pytest.mark.parametrize(
    "text, expected",
    [
        (
            "python-variable-function-computer-monitor",
            "computer-function-monitor-python-variable",
        ),                                   # normal case
        ("z-a-b", "a-b-z"),                  # simple case
        ("grape-grape-apple", "apple-grape-grape"),  # with duplicates
    ],
)
def test_sort_hyphen_words_success(text, expected):
    assert sort_hyphen_words(text) == expected


# ========= EXERCISE 7: primes from list =========
@pytest.mark.parametrize(
    "numbers, expected",
    [
        ([1, 4, 6, 7, 13, 9, 67], [7, 13, 67]),  # example case
        ([2, 3, 5, 11], [2, 3, 5, 11]),          # all primes
        ([0, 1, -3, 4, 8, 9, 10], []),           # no primes
    ],
)
def test_primes_from_list_success(numbers, expected):
    assert primes_from_list(numbers) == expected
