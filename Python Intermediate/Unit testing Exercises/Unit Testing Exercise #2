# test_functions.py
import pytest

from exercises import (
    sum_list,
    reverse_string,
    count_upper_lower,
    sort_hyphen_words,
    primes_from_list,
)

# ========= EXERCISE 3: sum of list =========

def test_sum_list_normal_case():
    assert sum_list([4, 6, 2, 29]) == 41


def test_sum_list_empty_list():
    assert sum_list([]) == 0


def test_sum_list_with_negatives():
    assert sum_list([-5, 10, 0, 3]) == 8


# ========= EXERCISE 4: reverse string =========

def test_reverse_string_normal():
    assert reverse_string("Hello world") == "dlrow olleH"


def test_reverse_string_empty():
    assert reverse_string("") == ""


def test_reverse_string_mixed_characters():
    assert reverse_string("AbC 123!") == "!321 CbA"


# ========= EXERCISE 5: count uppercase and lowercase =========

def test_count_upper_lower_prompt_example():
    assert count_upper_lower("I love Nación Sushi") == (3, 13)


def test_count_upper_lower_balanced():
    assert count_upper_lower("ABCdef") == (3, 3)


def test_count_upper_lower_only_lowercase():
    assert count_upper_lower("all lowercase") == (0, 12)


# ========= EXERCISE 6: sort hyphen-separated words =========

def test_sort_hyphen_words_normal():
    assert sort_hyphen_words(
        "python-variable-function-computer-monitor"
    ) == "computer-function-monitor-python-variable"


def test_sort_hyphen_words_simple():
    assert sort_hyphen_words("z-a-b") == "a-b-z"


def test_sort_hyphen_words_with_duplicates():
    assert sort_hyphen_words("grape-grape-apple") == "apple-grape-grape"


# ========= EXERCISE 7: primes from list =========

def test_primes_from_list_example():
    assert primes_from_list([1, 4, 6, 7, 13, 9, 67]) == [7, 13, 67]


def test_primes_from_list_all_primes():
    assert primes_from_list([2, 3, 5, 11]) == [2, 3, 5, 11]


def test_primes_from_list_no_primes():
    assert primes_from_list([0, 1, -3, 4, 8, 9, 10]) == []
