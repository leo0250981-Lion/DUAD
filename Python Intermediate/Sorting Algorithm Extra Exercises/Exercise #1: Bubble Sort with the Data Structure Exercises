def bubble_sort(arr):
    n = len(arr)

    # Repeat passes through the list
    for i in range(n - 1):
        # In each pass compare adjacent elements
        for j in range(0, n - 1 - i):
            # If the current element is greater than the next one,
            # perform a swap
            if arr[j] > arr[j + 1]:
                temp = arr[j]           # store temporarily
                arr[j] = arr[j + 1]     # move the smaller forward
                arr[j + 1] = temp       # place the larger backward

    return arr


