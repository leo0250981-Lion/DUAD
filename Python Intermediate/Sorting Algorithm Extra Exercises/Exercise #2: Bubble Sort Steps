def bubble_sort_steps(arr):
    n = len(arr)
    iterations = 0
    swaps = 0

    for i in range(n - 1):
        iterations += 1  # count each pass

        for j in range(0, n - 1 - i):
            if arr[j] > arr[j + 1]:
                # manual swap process
                temp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp

                swaps += 1  # count each swap

    print("Sorted list:", arr)
    print("Iterations:", iterations)
    print("Swaps:", swaps)

    return arr


