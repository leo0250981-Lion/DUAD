#Basic Queue (Linked Objects) 

class QueueNode:
    def __init__(self, data):
        self.data = data
        self.next = None


class Queue:
    def __init__(self):
        self.front = None
        self.rear = None

    def enqueue(self, data):
        new_node = QueueNode(data)

        if self.rear is None:
            self.front = self.rear = new_node
        else:
            self.rear.next = new_node
            self.rear = new_node

    def dequeue(self):
        if self.front is None:
            return None

        removed_data = self.front.data
        self.front = self.front.next

        if self.front is None:
            self.rear = None

        return removed_data

    def print_all(self):
        current = self.front

        while current is not None:
            print(current.data, end="")
            if current.next is not None:
                print(" -> ", end="")
            current = current.next
        print()

# Example of Usage 

# q = Queue()

# q.enqueue("A")
# q.enqueue("B")
# q.enqueue("C")

# q.print_all()
# Output: A -> B -> C

# print(q.dequeue())
# Output: A

# q.print_all()
# Output: B -> C
