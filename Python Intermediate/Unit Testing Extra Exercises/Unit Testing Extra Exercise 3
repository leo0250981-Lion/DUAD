import unittest
from unittest.mock import patch, mock_open
from file_reader import read_lines


class TestReadLines(unittest.TestCase):

    # Test reading expected lines using mock
    @patch("builtins.open", new_callable=mock_open, read_data="line1\nline2\nline3\n")
    def test_read_lines_returns_expected_content(self, mock_file):
        result = read_lines("fake_path.txt")
        expected = ["line1\n", "line2\n", "line3\n"]
        self.assertEqual(result, expected)

    # Test FileNotFoundError
    @patch("builtins.open", side_effect=FileNotFoundError)
    def test_file_not_found(self, mock_file):
        with self.assertRaises(FileNotFoundError):
            read_lines("missing_file.txt")


if __name__ == "__main__":
    unittest.main()
