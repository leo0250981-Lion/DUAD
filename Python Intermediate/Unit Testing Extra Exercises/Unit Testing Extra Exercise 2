import unittest


class Calculator:

    def divide(self, a, b):
        if not isinstance(a, (int, float)) or not isinstance(b, (int, float)):
            raise TypeError("Both parameters must be numbers")

        if b == 0:
            raise ValueError("Cannot divide by zero")

        return a / b


class TestDivision(unittest.TestCase):

    def setUp(self):
        self.calculator = Calculator()

    # Valid division
    def test_valid_division(self):
        self.assertEqual(self.calculator.divide(10, 2), 5.0)

    # Division by zero should raise ValueError
    def test_division_by_zero(self):
        with self.assertRaises(ValueError):
            self.calculator.divide(10, 0)

    #  Division with string should raise TypeError
    def test_division_with_string(self):
        with self.assertRaises(TypeError):
            self.calculator.divide("10", 2)


if __name__ == "__main__":
    unittest.main()
