def bubble_sort(arr):
    n = len(arr)

    for i in range(n):
        # After each pass, the largest element
        # is placed at the end, so we can reduce the range.
        for j in range(0, n - i - 1):
            if arr[j] > arr[j + 1]:
                # Swap
                arr[j], arr[j + 1] = arr[j + 1], arr[j]

    return arr


